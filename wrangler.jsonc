// Publicação no Cloudflare (Workers com arquivos estáticos): o site é só esta pasta, sem build.
// O nome precisa ser o mesmo do projeto criado no painel do Cloudflare.
{
  "name": "appgustavo",
  "compatibility_date": "2025-09-01",
  // Endereço grátis do Cloudflare: appgustavo.<seu-subdominio>.workers.dev
  "workers_dev": true,
  // Sem endereços de pré-visualização (não são usados).
  "preview_urls": false,
  "assets": {
    "directory": "./"
  }
}
